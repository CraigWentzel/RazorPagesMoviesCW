@page
@model RazorPagesMovie.Pages_Movies.IndexModel

@{
    ViewData["Title"] = "RP Movies";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form>
    <div class="row">

        <div class="col-md-3">
            <label>Title</label>
            <input type="text" asp-for="SearchString" class="form-control" />
        </div>

        <div class="col-md-3">
            <label>Genre</label>
            <input type="text" asp-for="GenreSearch" class="form-control" />
        </div>

        <div class="col-md-2">
            <label>&nbsp;</label>
            <input type="submit" value="Filter" class="btn btn-primary form-control" />
        </div>

       <div class="col-md-2">
    <label>&nbsp;</label>
    <a asp-page="./Index"
       class="btn btn-secondary form-control">
        Clear
    </a>
</div>

    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Poster</th>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].Rating)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Movie) {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(item.PosterPath))
        {
            <img src="~/posters/@item.PosterPath"
             alt="@item.Title poster"
             style="height:80px;" />
        }
           </td>


            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Genre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
             <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
